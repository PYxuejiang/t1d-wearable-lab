HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
HEALTH_DATA_DIR=.private/health-agent
# Generate two DIFFERENT 32-byte hex secrets locally. Never use VITE_ prefixes.
HEALTH_DATA_KEY=
HEALTH_TOKEN_SECRET=
# Exact allowed frontend origin, no path. No wildcard CORS.
HEALTH_ALLOWED_ORIGIN=http://127.0.0.1:5173
HEALTH_LLM_ENABLED=false
DEEPSEEK_API_KEY=
HEALTH_MODEL=deepseek-flash
# Run worker.ts as a private always-on service, alongside server.ts.
# Reports become visible in the authenticated inbox; there is no email transport.
