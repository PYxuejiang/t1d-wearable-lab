{
  "name": "t1d-wearable-health-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "agent:start": "node --experimental-strip-types agent/server.ts",
    "agent:worker": "node --experimental-strip-types agent/worker.ts",
    "agent:token": "node --experimental-strip-types agent/cli.ts token",
    "evidence:refresh": "node --experimental-strip-types agent/cli.ts refresh",
    "evidence:review": "node --experimental-strip-types agent/cli.ts review",
    "check": "node scripts/check-agent.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
